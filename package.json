{
  "name": "pi-interactive-subagents",
  "version": "3.7.2-earendil-local.3",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in cmux/tmux/zellij terminals",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "HazAT",
  "repository": {
    "type": "git",
    "url": "https://github.com/re-miranda/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts test/availability.test.ts test/paths.test.ts test/claude-command.test.ts test/tmux.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ],
    "capabilities": {
      "claudeCodeLaunchPolicy": "auto-permissions-v1"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "typebox": "1.3.7"
  }
}
